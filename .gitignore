# Rust build output
/target/
/tmp/
**/*.rs.bk
*.pdb

# Local application state and diagnostics
/.diskpie/
*.log
diskpie-diagnostics-*.zip

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local agent working directories. The reviewed project skill lives in
# .agents/skills and .claude/skills; everything else under these roots is
# session state that must never reach the public repository.
/.agents/*
!/.agents/skills/
/.claude/*
!/.claude/skills/

# Protected legacy reference material must never enter this repository.
**/Scanner.exe
**/Scanner.lang
**/Scanner.en.txt
**/Scanner.de.txt
**/Add Scanner to Context Menu.reg
**/Delete Scanner from Context Menu.reg
